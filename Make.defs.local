DIM           ?= 3
DEBUG          = FALSE
PRECISION      = DOUBLE
OPT            = TRUE
PROFILE        = FALSE
CXX            = g++
FC             = gfortran
MPI            = TRUE
OPENMPCC       = TRUE
MPICXX         = mpicxx
USE_64         = TRUE
USE_HDF        = TRUE
HDFINCFLAGS    = -I/usr/include/hdf5/openmpi
HDFLIBFLAGS    = -L/usr/lib/x86_64-linux-gnu/hdf5/openmpi -lhdf5 -lz
HDFMPIINCFLAGS = -I/usr/include/hdf5/openmpi
HDFMPILIBFLAGS = -L/usr/lib/x86_64-linux-gnu/hdf5/openmpi -lhdf5 -lz
NAMESPACE      = TRUE
syslibflags    = -llapack -lblas
cxxoptflags    = -march=native -O3
foptflags      = -march=native -O3 